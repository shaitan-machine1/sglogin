pkgbase=s6-services
pkgname=(sessiond-s6)
pkgver=0.1.0
pkgrel=6
arch=(any)
url='https://github.com/shaitan-machine1/sglogin'
license=(GPL-3.0-only)

package_sessiond-s6() {
  pkgdesc='s6-rc service definition for sessiond'
  depends=(dbus-s6 s6-base s6-rc sessiond)
  install -d "$pkgdir/etc/s6/sv"
  cp -a "$startdir/services/sessiond-srv" "$startdir/services/sessiond-log" "$pkgdir/etc/s6/sv/"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
