pkgname=libseat
pkgver=0.9.3
pkgrel=2
pkgdesc='C libseat with inherited connections and explicit per-seat multiseatd bootstrap'
arch=(x86_64)
url='https://github.com/shaitan-machine1/seatd'
license=(MIT)
provides=('libseat.so' 'seatd=0.9.3')
conflicts=('seatd')
depends=(glibc dbus)
makedepends=(git meson ninja)
_commit=42fe3abfdcaefd2d5cbd21f9db803b9da6a2ca6c
source=("libseat::git+https://github.com/shaitan-machine1/seatd.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  meson setup build "$srcdir/libseat" \
    --prefix=/usr \
    --buildtype=plain \
    -Dexamples=disabled \
    -Dserver=disabled \
    -Dlibseat-seatd=enabled \
    -Dlibseat-multiseatd=enabled \
    -Dlibseat-logind=disabled \
    -Dlibseat-builtin=disabled \
    -Dman-pages=disabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="$pkgdir" meson install -C build
  install -Dm644 "$srcdir/libseat/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
