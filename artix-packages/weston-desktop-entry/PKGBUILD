pkgname=sglogin-weston-desktop-entry
pkgver=0.1.0
pkgrel=2
pkgdesc='Separate context-managed Weston entrypoint (no desktop supervisor)'
arch=(any)
url='https://github.com/shaitan-machine1/sglogin'
license=(GPL-3.0-only)
depends=('multiseatd>=0.4.0' weston)
source=(sglogin-weston sglogin-weston.desktop)
sha256sums=('SKIP' 'SKIP')
package() {
  install -Dm755 "$srcdir/sglogin-weston" "$pkgdir/usr/bin/sglogin-weston"
  install -Dm644 "$srcdir/sglogin-weston.desktop" "$pkgdir/usr/share/wayland-sessions/sglogin-weston.desktop"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
