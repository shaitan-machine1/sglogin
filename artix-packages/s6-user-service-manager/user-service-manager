#!/bin/sh
set -eu

if [ "$#" -ne 2 ] || [ "$1" != --ready-fd ]; then
    echo 'usage: user-service-manager --ready-fd FD' >&2
    exit 64
fi
ready_fd=$2
case $ready_fd in ''|*[!0-9]*) exit 64 ;; esac
[ "$ready_fd" -ge 3 ] 2>/dev/null || exit 64

: "${HOME:?HOME is required}"
: "${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}"
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
for directory in "$HOME" "$config_home" "$data_home" "$XDG_RUNTIME_DIR"; do
    case $directory in /*) ;; *) echo "path must be absolute: $directory" >&2; exit 65 ;; esac
done

# Persistent frontend-compatible state; no s6-frontend dependency or config.
system_sv=/etc/s6/user/sv
admin_sv=/etc/s6/user/adminsv
user_sv=$config_home/s6/sv
state=$data_home/s6
repo=$state/repository
bootdir=$state/compiled
bootdb=$bootdir/current
# Only scanner, live state and scratch space are disposable.
base=$XDG_RUNTIME_DIR/s6
scandir=$base/scandir
live=$base/live
stmpdir=$base/tmp
uid=$(id -u)
svscan_pid=
live_started=0

shutdown() {
    trap '' TERM INT HUP
    if [ "$live_started" -eq 1 ]; then
        timeout 10 s6-rc -l "$live" -da change 2>/dev/null || :
    fi
    if [ -n "$svscan_pid" ]; then
        s6-svscanctl -t "$scandir" 2>/dev/null || :
        count=0
        while kill -0 "$svscan_pid" 2>/dev/null; do
            count=$((count + 1))
            [ "$count" -lt 1000 ] || { kill "$svscan_pid" 2>/dev/null || :; break; }
            sleep 0.01
        done
        wait "$svscan_pid" 2>/dev/null || :
    fi
}
trap 'exit 0' TERM INT HUP
trap 'status=$?; eval "exec $ready_fd>&-"; shutdown; exit "$status"' EXIT

# Preserve the source ownership and no-symlink contract. Repositories link
# the real stores directly; later stores override earlier definitions.
validate_store() {
    store=$1
    owner=$2
    [ -e "$store" ] || [ -L "$store" ] || return 0
    [ -d "$store" ] && [ ! -L "$store" ] || {
        echo "invalid service store: $store" >&2; exit 65
    }
    bad=$(find "$store" \( ! -user "$owner" -o -type l -o -type b -o -type c -o -type p -o -type s \) -print -quit)
    if [ "$owner" -eq 0 ] && [ -z "$bad" ]; then
        bad=$(find "$store" -perm /022 -print -quit)
    fi
    [ -z "$bad" ] || { echo "unsafe service source: $bad" >&2; exit 65; }
    for service in "$store"/*; do
        [ -e "$service" ] || continue
        case ${service##*/} in
            default) echo "default is generated; remove source: $service" >&2; exit 65 ;;
            *[!A-Za-z0-9_.-]*|[.-]*|*..*) echo "invalid service name: $service" >&2; exit 65 ;;
        esac
        [ -d "$service" ] || { echo "not a service directory: $service" >&2; exit 65; }
    done
}

[ -d "$XDG_RUNTIME_DIR" ] && [ ! -L "$XDG_RUNTIME_DIR" ] &&
    [ "$(stat -c %u "$XDG_RUNTIME_DIR")" -eq "$uid" ] || {
    echo 'invalid XDG_RUNTIME_DIR ownership or type' >&2; exit 65
}
validate_store "$system_sv" 0
validate_store "$admin_sv" 0
validate_store "$user_sv" "$uid"
for directory in "$user_sv" "$state" "$bootdir" "$base"; do
    [ ! -L "$directory" ] || { echo "directory is a symlink: $directory" >&2; exit 65; }
    (umask 077; mkdir -p "$directory")
    [ "$(stat -c %u "$directory")" -eq "$uid" ] || {
        echo "directory belongs to another uid: $directory" >&2; exit 65
    }
done

set --
for store in "$system_sv" "$admin_sv" "$user_sv"; do
    [ ! -d "$store" ] || set -- "$@" "$store"
done
if [ -e "$repo" ] || [ -L "$repo" ]; then
    [ -d "$repo" ] && [ ! -L "$repo" ] && [ "$(stat -c %u "$repo")" -eq "$uid" ] || {
        echo "invalid repository: $repo" >&2; exit 65
    }
    s6-rc-repo-init -U -r "$repo" "$@"
else
    s6-rc-repo-init -r "$repo" "$@"
fi
if [ ! -e "$repo/sources/current" ] && [ ! -L "$repo/sources/current" ]; then
    s6-rc-set-new -r "$repo" current
fi
# Bootstrap once. Later logins use only the installed database, never apply
# pending enable/disable changes from the working set implicitly.
if [ ! -e "$bootdb" ] && [ ! -L "$bootdb" ]; then
    s6-rc-set-commit -r "$repo" -D default current
    s6-rc-set-install -r "$repo" -c "$bootdb" -l "$live" \
        --no-update --no-snapshot current
fi
[ -L "$bootdb" ] && [ -d "$bootdb" ] || {
    echo "installed database is not a valid symlink: $bootdb" >&2; exit 65
}

umask 077
rm -rf "$scandir" "$live" "$stmpdir"
mkdir -p "$scandir" "$stmpdir"
s6-svscan "$scandir" &
svscan_pid=$!
count=0
until s6-svscanctl -a "$scandir" 2>/dev/null; do
    kill -0 "$svscan_pid" 2>/dev/null || { echo 's6-svscan exited during startup' >&2; exit 1; }
    count=$((count + 1))
    [ "$count" -lt 3000 ] || { echo 's6-svscan startup timed out' >&2; exit 1; }
    sleep 0.01
done
live_started=1
s6-rc-init -c "$bootdb" -l "$live" "$scandir"
s6-rc -l "$live" -u change default
eval "printf '\\n' >&$ready_fd"
eval "exec $ready_fd>&-"
status=0
wait "$svscan_pid" || status=$?
svscan_pid=
[ "$status" -eq 0 ] || { echo "s6-svscan exited with status $status" >&2; exit "$status"; }
