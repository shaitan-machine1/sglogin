pkgname=sessiond
pkgver=0.1.1
pkgrel=1
pkgdesc='PAM-integrated session lifecycle service'
arch=(x86_64)
url='https://github.com/shaitan-machine1/sessiond'
license=(GPL-3.0-only)
provides=('session-manager')
depends=(dbus gcc-libs glibc pam user-service-manager)
makedepends=(cargo git rust)
backup=('etc/sessiond.conf' 'etc/pam.d/sessiond-user')
_commit=c87c83d8929fbe0fe63d0012324fbd7f957e98c0
source=("git+https://github.com/shaitan-machine1/sessiond.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cd "$srcdir/sessiond"
  SESSIOND_USER_SERVICE_MANAGER=/usr/libexec/user-service-manager \
    CARGO_TARGET_DIR=target cargo build --release --locked --workspace
}

check() {
  cd "$srcdir/sessiond"
  SESSIOND_USER_SERVICE_MANAGER=/usr/libexec/user-service-manager \
    CARGO_TARGET_DIR=target cargo test --release --locked --workspace
}

package() {
  cd "$srcdir/sessiond"
  install -Dm755 target/release/sessiond "$pkgdir/usr/bin/sessiond"
  install -Dm755 target/release/sessiond-user-launcher \
    "$pkgdir/usr/libexec/sessiond/sessiond-user-launcher"
  install -Dm755 target/release/libpam_sessiond.so \
    "$pkgdir/usr/lib/security/pam_sessiond.so"
  install -Dm644 dist/sessiond.conf "$pkgdir/etc/sessiond.conf"
  install -Dm644 dist/pam/sessiond-user "$pkgdir/etc/pam.d/sessiond-user"
  install -Dm644 dist/dbus/org.decoupling.sessiond1.conf \
    "$pkgdir/usr/share/dbus-1/system.d/org.decoupling.sessiond1.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
