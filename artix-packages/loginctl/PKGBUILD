pkgname=loginctl
pkgver=0.4.0
pkgrel=1
pkgdesc='Unified administration for the decoupled login stack'
arch=(x86_64)
url='https://github.com/shaitan-machine1/loginctl'
license=(GPL-3.0-only)
depends=(dbus gcc-libs glibc libudev udev)
makedepends=(cargo git rust)
checkdepends=(pam)
optdepends=('multiseatd>=0.4.0: administer explicitly configured seats and contexts'
            'sessiond>=0.2.0: inspect and close managed sessions')
backup=('etc/loginctl.conf')
_commit=f8c241ba7a425e082b8ce0d1b683e28cb6a9ae76
source=("git+https://github.com/shaitan-machine1/loginctl.git#commit=$_commit"
        loginctl.conf)
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd "$srcdir/loginctl"
  CARGO_TARGET_DIR=target cargo fetch --locked
}

build() {
  cd "$srcdir/loginctl"
  CARGO_TARGET_DIR=target cargo build --release --locked --offline
}

check() {
  cd "$srcdir/loginctl"
  CARGO_TARGET_DIR=target cargo test --release --locked --all-targets --offline
  ./tests/pam-env.sh
}

package() {
  cd "$srcdir/loginctl"
  install -Dm755 target/release/loginctl "$pkgdir/usr/bin/loginctl"
  install -Dm644 "$srcdir/loginctl.conf" "$pkgdir/etc/loginctl.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
