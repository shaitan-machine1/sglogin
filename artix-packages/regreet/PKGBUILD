pkgname=greetd-regreet
pkgver=0.5.0
pkgrel=1
pkgdesc='Unmodified ReGreet GTK greeter for the standard greetd protocol'
arch=(x86_64)
url='https://github.com/rharish101/ReGreet'
license=(GPL-3.0-or-later)
depends=(gcc-libs glibc glib2 gtk4)
makedepends=(cargo git rust)
provides=(greetd-greeter)
optdepends=('glycin: image loaders for optional backgrounds')
_commit=290e6f8d65b7034c5b63bc950a20bcf8277ebe5f
source=("regreet::git+https://github.com/rharish101/ReGreet.git#commit=$_commit")
sha256sums=('SKIP')
prepare() { cd "$srcdir/regreet"; CARGO_TARGET_DIR=target cargo fetch --locked; }
build() { cd "$srcdir/regreet"; CARGO_TARGET_DIR=target cargo build --release --locked --offline; }
check() { cd "$srcdir/regreet"; CARGO_TARGET_DIR=target cargo test --release --locked --offline; }
package() {
  cd "$srcdir/regreet"
  install -Dm755 target/release/regreet "$pkgdir/usr/bin/regreet"
  install -Dm644 regreet.sample.toml "$pkgdir/usr/share/doc/regreet/regreet.sample.toml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
