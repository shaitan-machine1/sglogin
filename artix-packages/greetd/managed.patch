+                        | "NLSPATH"
+                        | "GLIBC_TUNABLES"
+                        | "BASH_ENV"
+                        | "ENV"
+                        | "SHELLOPTS"
+                        | "BASHOPTS"
+                        | "PYTHONPATH"
+                        | "PYTHONHOME"
+                        | "PERL5OPT"
+                        | "PERL5LIB"
+                        | "RUBYOPT"
+                        | "NODE_OPTIONS"
+                        | "DBUS_SYSTEM_BUS_ADDRESS"
+                        | "MULTISEATD_AUTHORITY_FD"
+                        | "MULTISEATD_CONTEXT_ID"
+                        | "SEATD_FD"
+                        | "LIBSEAT_BACKEND"
