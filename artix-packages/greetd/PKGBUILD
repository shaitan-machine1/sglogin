pkgname=greetd-multiseatd
pkgver=0.10.3
pkgrel=5
pkgdesc='Privileged per-session PAM hosts with certified multiseatd handoff and stock ReGreet in Cage'
arch=(x86_64)
url='https://github.com/shaitan-machine1/greetd'
license=(GPL-3.0-only)
depends=(dbus gcc-libs glibc pam pambase esysusers etmpfiles 'multiseatd>=0.4.0' sessiond cage greetd-regreet)
makedepends=(cargo git rust)
provides=(greetd=0.10.3)
conflicts=(greetd pam_rundir)
optdepends=('sglogin-weston-desktop-entry: managed Weston desktop entrypoint')
backup=('etc/greetd/seat0.toml' 'etc/greetd/seat1.toml' 'etc/pam.d/greetd' 'etc/pam.d/greetd-greeter' 'etc/tmpfiles.d/regreet.conf')
_commit=8890e19ad27e38ee0b563ae76116510351935b7c
source=("git+https://github.com/shaitan-machine1/greetd.git#commit=$_commit"
        greetd.pam greetd-greeter.pam greetd.sysusers regreet.conf seat0.toml seat1.toml)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')
prepare() {
  cd "$srcdir/greetd"
  cargo fetch --locked
}
build() {
  cd "$srcdir/greetd"
  # Never ship test-support (private PAM, preload and mlock bypass hooks).
  CARGO_TARGET_DIR=target cargo build --release --locked --offline -p greetd
}
check() {
  cd "$srcdir/greetd"
  CARGO_TARGET_DIR=target cargo test --release --locked --offline --workspace --all-targets
}
package() {
  cd "$srcdir/greetd"
  install -Dm755 target/release/greetd "$pkgdir/usr/bin/greetd"
  install -Dm644 README.multiseat.md "$pkgdir/usr/share/doc/greetd/managed.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/greetd.pam" "$pkgdir/etc/pam.d/greetd"
  install -Dm644 "$srcdir/greetd-greeter.pam" "$pkgdir/etc/pam.d/greetd-greeter"
  install -Dm644 "$srcdir/greetd.sysusers" "$pkgdir/usr/lib/sysusers.d/greetd.conf"
  # Same basename overrides the distro ReGreet definition, not duplicate paths
  # in a second tmpfiles fragment. Keep the distro package itself unmodified.
  install -Dm644 "$srcdir/regreet.conf" "$pkgdir/etc/tmpfiles.d/regreet.conf"
  for seat in seat0 seat1; do install -Dm644 "$srcdir/$seat.toml" "$pkgdir/etc/greetd/$seat.toml"; done
}
