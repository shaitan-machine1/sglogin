pkgname=cage
pkgver=0.3.1
pkgrel=1
pkgdesc='Stock Cage kiosk compositor with wlroots 0.20 and maintained C libseat'
arch=(x86_64)
url='https://github.com/cage-kiosk/cage'
license=(MIT)
depends=(glibc libseat libxkbcommon wayland 'wlroots0.20=0.20.2')
makedepends=(git meson ninja pkgconf scdoc wayland-protocols)
_commit=b7b774ac957b6d8c7b39f0dcb9ebe19de3e8a45d
source=("git+https://github.com/cage-kiosk/cage.git#commit=$_commit")
sha256sums=('SKIP')
build() {
  meson setup "$srcdir/build" "$srcdir/cage" --prefix=/usr --buildtype=release
  meson compile -C "$srcdir/build"
}
check() { meson test -C "$srcdir/build" --print-errorlogs; }
package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build"
  install -Dm644 "$srcdir/cage/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
