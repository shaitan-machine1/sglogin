pkgbase = seat-services
	pkgver = 0.1.0
	pkgrel = 2
	url = https://github.com/shaitan-machine1/sglogin
	arch = any
	license = GPL-3.0-only
	source = multiseatd-seat0
	source = greetd-seat0
	source = greetd-seat1
	source = 74-multiseatd-vts.rules
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = multiseatd-seat0-s6
	pkgdesc = Native VT7–11 multiseatd seat0 s6 service
	depends = dbus-s6
	depends = multiseatd>=0.4.0
	depends = s6-base
	depends = s6-rc
	depends = udev
	backup = etc/conf.d/multiseatd-seat0

pkgname = multiseatd-seat1-s6
	pkgdesc = Non-VT multiseatd seat1 s6 service
	depends = dbus-s6
	depends = multiseatd>=0.4.0
	depends = s6-base
	depends = s6-rc
	depends = udev

pkgname = greetd-seat0-s6
	pkgdesc = Managed greetd seat0 VT7 controller s6 service
	depends = coreutils
	depends = dbus-s6
	depends = greetd-multiseatd
	depends = loginctl
	depends = multiseatd-seat0-s6
	depends = sessiond-s6
	depends = s6-base
	depends = s6-rc
	depends = udev
	provides = init-greetd
	conflicts = init-greetd
	conflicts = init-sddm
	backup = etc/conf.d/greetd-seat0

pkgname = greetd-seat1-s6
	pkgdesc = Additional non-VT managed greetd seat1 controller s6 service
	depends = coreutils
	depends = dbus-s6
	depends = greetd-multiseatd
	depends = loginctl
	depends = multiseatd-seat1-s6
	depends = sessiond-s6
	depends = s6-base
	depends = s6-rc
	depends = udev
	backup = etc/conf.d/greetd-seat1
