#!/bin/sh
set -eu
exec 2>&1
# Ordering alone is not readiness. Failure exits for ordinary s6 supervision;
# no compositor/GPU retry or main-process context RPC fallback is introduced.
timeout 12 /usr/bin/loginctl seat context seat0 list >/dev/null
exec /usr/bin/greetd --config /etc/greetd/seat0.toml
